<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material Design 3 Dark Theme for TV & Touch -->
    <style name="Theme.TjUnicomIptv" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/md_theme_dark_primary</item>
        <item name="colorOnPrimary">@color/md_theme_dark_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_dark_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_dark_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_theme_dark_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_dark_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_dark_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_dark_onSecondaryContainer</item>
        <item name="colorTertiary">@color/md_theme_dark_tertiary</item>
        <item name="colorSurface">@color/md_theme_dark_surface</item>
        <item name="colorOnSurface">@color/md_theme_dark_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_dark_surfaceContainerHigh</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_dark_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_theme_dark_outline</item>
        <item name="colorControlHighlight">@color/md_theme_dark_ripple</item>

        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>
        <item name="android:windowFullscreen">true</item>

        <!-- Material AlertDialog Theme Overlay -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.TjUnicomIptv.MaterialAlertDialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.TjUnicomIptv.MaterialAlertDialog</item>
    </style>

    <style name="ThemeOverlay.TjUnicomIptv.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/md_theme_dark_surfaceContainer</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorPrimary">@color/md_theme_dark_primary</item>
        <item name="android:background">@drawable/bg_md3_dialog_surface</item>
        <item name="android:windowBackground">@drawable/bg_md3_dialog_surface</item>
    </style>

    <!-- Material 3 Tonal Action Chip Button (HUD & Top Bar) -->
    <style name="Widget.TjUnicomIptv.HudButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_group_tab</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Material 3 Primary Filled Button -->
    <style name="Widget.TjUnicomIptv.PrimaryButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_md3_primary_button</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
